{
  "name": "database-studio-vscode",
  "displayName": "Database Studio",
  "description": "Universal database client for VS Code with support for Oracle, SQL Server, PostgreSQL, MySQL, DuckDB, and SQLite, visual query runner, ER diagrams, and editable data grid.",
  "version": "1.0.0",
  "publisher": "database-studio",
  "icon": "public/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/database-studio/database-studio"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Data Science",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "database",
    "sql",
    "oracle",
    "sql server",
    "postgres",
    "mysql",
    "sqlite",
    "duckdb"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onCommand:database-studio.open",
    "onCommand:database-studio.newQuery",
    "onCommand:database-studio.openErd",
    "onView:database-studio.sidebarView"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "database-studio-container",
          "title": "Database Studio",
          "icon": "public/icon.svg"
        }
      ]
    },
    "views": {
      "database-studio-container": [
        {
          "type": "webview",
          "id": "database-studio.sidebarView",
          "name": "Database Navigator"
        }
      ]
    },
    "commands": [
      {
        "command": "database-studio.open",
        "title": "Open Database Studio",
        "category": "Database Studio",
        "icon": "$(database)"
      },
      {
        "command": "database-studio.newQuery",
        "title": "New SQL Script",
        "category": "Database Studio",
        "icon": "$(new-file)"
      },
      {
        "command": "database-studio.openErd",
        "title": "Open ER Diagram",
        "category": "Database Studio",
        "icon": "$(type-hierarchy)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "database-studio.open"
        },
        {
          "command": "database-studio.newQuery"
        },
        {
          "command": "database-studio.openErd"
        }
      ],
      "view/title": [
        {
          "command": "database-studio.newQuery",
          "when": "view == database-studio.sidebarView",
          "group": "navigation@1"
        },
        {
          "command": "database-studio.openErd",
          "when": "view == database-studio.sidebarView",
          "group": "navigation@2"
        }
      ]
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build:client": "vite build",
    "build:extension": "tsc -p tsconfig.extension.json && node -e \"fs.writeFileSync('out/package.json', JSON.stringify({ type: 'commonjs' }, null, 2))\"",
    "build": "vite build && npm run build:extension",
    "preview": "vite preview",
    "clean": "node -e \"['dist', 'out'].forEach(d => { try { fs.rmSync(d, { recursive: true, force: true }); } catch (e) {} })\"",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/utils/erDiagramLayout.test.ts src/utils/exportData.test.ts src/utils/sqlCompletion.test.ts src/utils/sqlFormatter.test.ts src/utils/tableManagement.test.ts src/engine/sqlEngineCore.test.ts src/engine/databaseManager.test.ts",
    "package:extension": "npm run build && npx @vscode/vsce package --no-dependencies --allow-missing-repository",
    "publish:extension": "npm run build && npx @vscode/vsce publish"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/sql.js": "^1.4.11",
    "@types/vscode": "^1.85.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sql.js": "^1.15.2",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
