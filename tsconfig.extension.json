{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "outDir": "out",
    "lib": ["ES2022"],
    "sourceMap": true,
    "rootDir": "src-extension",
    "strict": false,
    "skipLibCheck": true,
    "types": ["node", "vscode"]
  },
  "include": ["src-extension"],
  "exclude": ["src-extension/**/*.test.ts"]
}
